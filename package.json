{
  "name": "figma-rust-mcp",
  "version": "5.0.0",
  "description": "Claude Code to Figma — Bidirectional MCP bridge. AI draws UI on Figma canvas, reads designs back. Works with Claude, Cursor, VS Code, Windsurf, Antigravity. No API key needed.",
  "mcpName": "io.github.BuiHung1612/figma-rust-mcp",
  "type": "module",
  "bin": {
    "figma-rust-mcp": "bin/figma-rust-mcp.js"
  },
  "files": [
    "bin",
    "plugin",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:plugin && cargo build --release",
    "build:plugin": "node scripts/build-plugin.js",
    "test": "./scripts/test-rust-mcp.sh",
    "test:tokens": "node --test scripts/test-plugin-tokens.mjs && cargo test",
    "dev": "cargo run",
    "bench": "cargo build --release && node scripts/bench.mjs",
    "test:sessions": "cargo build && node --test scripts/test-bridge-sessions.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "cursor",
    "windsurf",
    "vscode",
    "antigravity",
    "ai",
    "design",
    "plugin",
    "figma-plugin",
    "ui-generation",
    "figma-rust-mcp",
    "ai-to-figma",
    "claude-to-figma",
    "code-to-figma",
    "design-to-code",
    "figma-bridge",
    "figma-automation"
  ],
  "license": "MIT",
  "author": "BuiHung1612",
  "homepage": "https://github.com/BuiHung1612/figma-mcp#readme",
  "bugs": {
    "url": "https://github.com/BuiHung1612/figma-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuiHung1612/figma-mcp.git"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
